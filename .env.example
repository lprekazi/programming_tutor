# Copy to .env.local and fill in. .env.local is never committed.

# API key for the tutor's language model. Server-side only.
OPENAI_API_KEY=

# Model identifier. Read from the environment so it can be changed without code changes.
OPENAI_MODEL=gpt-5.6-sol

# Where the learner database lives. Optional; defaults to data/tutor.db
# DATABASE_PATH=data/tutor.db

# Set to "mock" to run against the deterministic mock provider instead of the real API.
# Every automated test uses the mock, so no key is needed to run them.
# LLM_PROVIDER=mock
