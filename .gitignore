# Environment secrets
.env
.env.local
.env.*.local

# Safe environment template
!.env.example

# Local Claude configuration
CLAUDE.local.md
.claude/settings.local.json
.claude/agents/

# Private benchmark / research material
.benchmark-private/

# Dependencies / build output
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
# Local learner database
data/

# Pyodide runtime, copied from node_modules by scripts/copy-pyodide.mjs
public/pyodide/

# Next.js generated types
next-env.d.ts

# TypeScript incremental build info
*.tsbuildinfo

# Workers compiled from src/python by `npm run build:workers`
public/workers/

# Coding-agent instruction files generated by Next.js tooling. This project does not
# maintain a tracked agent-instruction file; Next.js guidance is read from the
# version-matched docs bundled at node_modules/next/dist/docs/ instead.
AGENTS.md
CLAUDE.md
